+    def test_light_mode_does_not_inherit_a_dark_operating_system_palette(self, app, monkeypatch):
+        from PyQt6.QtGui import QPalette
+
+        class DarkStyle:
+            def standardPalette(self):
+                return theme._dark_palette()
+
+        monkeypatch.setattr(QApplication, 'style', staticmethod(lambda: DarkStyle()))
+        theme.set_mode(app, 'light')
+        palette = app.palette()
+        assert palette.color(QPalette.ColorRole.Text).value() < 80
+        assert palette.color(QPalette.ColorRole.Base).value() > 200
+
+    def test_employee_table_text_is_dark_in_light_mode(self, window):
+        from PyQt6.QtGui import QPalette
+        table = window.employees_tab._table
+        assert table.palette().color(QPalette.ColorRole.Text).value() < 80
+        assert '#333333' in table.styleSheet()
+
