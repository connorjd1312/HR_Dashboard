<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>cbf6c510-1208-4478-b1a0-b27f48cc11c4</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>HR_Analytics_Dashboard.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>HR Analytics Dashboard</Name>
    <RootNamespace>HR Analytics Dashboard</RootNamespace>
    <InterpreterId>MSBuild|env2|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HR_Analytics_Dashboard.py" />
    <Compile Include="core\__init__.py" />
    <Compile Include="core\data_loader.py" />
    <Compile Include="core\data_cleaner.py" />
    <Compile Include="core\analytics.py" />
    <Compile Include="ui\__init__.py" />
    <Compile Include="ui\chart_widget.py" />
    <Compile Include="ui\filter_panel.py" />
    <Compile Include="ui\dashboard_tab.py" />
    <Compile Include="ui\charts_tab.py" />
    <Compile Include="ui\main_window.py" />
    <Compile Include="data\generate_sample.py" />
    <Compile Include="tests\test_analytics.py" />
    <Content Include="requirements.txt" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="core\" />
    <Folder Include="data\" />
    <Folder Include="tests\" />
    <Folder Include="ui\" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="env1\">
      <Id>env1</Id>
      <Version>3.14</Version>
      <Description>env1 (Python 3.14.4)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
    <Interpreter Include="env2\">
      <Id>env2</Id>
      <Version>3.9</Version>
      <Description>env2 (Python 3.9 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
    <Interpreter Include="env\">
      <Id>env</Id>
      <Version>3.14</Version>
      <Description>env (Python 3.14.4)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
