+def _drop(widget, mime_type, payload, pos):
+    mime = QMimeData()
+    mime.setData(mime_type, payload.encode())
+    ev = QDropEvent(QPointF(pos), Qt.DropAction.MoveAction, mime, Qt.MouseButton.LeftButton,
+                    Qt.KeyboardModifier.NoModifier)
+    widget.dropEvent(ev)
