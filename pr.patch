+        intro.setStyleSheet(_HINT)
+        v.addWidget(intro)
+
+        v.addSpacing(6)
+        v.addWidget(self._heading('Title'))
+        self._title = QLineEdit('HR Workforce Summary')
+        self._title.setStyleSheet('QLineEdit { padding: 6px 8px; border: 1px solid #CCC; border-radius: 4px; '
